<Window x:Class="Monitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Heartbeat Monitor"
        Height="620" Width="1020"
        MinHeight="520" MinWidth="820"
        SizeToContent="Manual"
        Background="#1A1A2E">

    <DockPanel Margin="10">

        <!-- Top panels: CONNECTIVITY + DISPLAY side by side -->
        <Grid DockPanel.Dock="Top" Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- CONNECTIVITY panel -->
            <Border Grid.Column="0" Background="#16213E" CornerRadius="4" Padding="10 6">
                <StackPanel>
                    <TextBlock Text="CONNECTIVITY" Foreground="#533483"
                               FontSize="9" FontWeight="Bold" Margin="0 0 0 6"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="Host" Foreground="#8892A4" VerticalAlignment="Center" Margin="0 0 4 0"/>
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                 Width="110" Margin="0 0 12 0" Padding="4 2"
                                 Background="#0F3460" Foreground="White" BorderBrush="#533483"/>

                        <TextBlock Text="Port" Foreground="#8892A4" VerticalAlignment="Center" Margin="0 0 4 0"/>
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 Width="55" Margin="0 0 16 0" Padding="4 2"
                                 Background="#0F3460" Foreground="White" BorderBrush="#533483"/>

                        <Button Content="Connect"
                                Command="{Binding ConnectCommand}"
                                Padding="16 4" Margin="0 0 6 0"
                                Background="#533483" Foreground="White" BorderThickness="0"/>
                        <Button Content="Disconnect"
                                Command="{Binding DisconnectCommand}"
                                Padding="16 4" Margin="0 0 16 0"
                                Background="#E94560" Foreground="White" BorderThickness="0"/>

                        <!-- Connection indicator dot + status -->
                        <Ellipse Width="10" Height="10" Margin="0 0 4 0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#00FF88"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" Foreground="#8892A4"
                                   VerticalAlignment="Center" FontSize="12"/>
                        <CheckBox Content="Simulator"
                                  IsChecked="{Binding UseSimulator, Mode=TwoWay}"
                                  Foreground="#8892A4" FontSize="11"
                                  VerticalAlignment="Center" Margin="16 0 0 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- DISPLAY panel -->
            <Border Grid.Column="1" Background="#16213E" CornerRadius="4" Padding="10 6" Margin="8 0 0 0"
                    VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="DISPLAY" Foreground="#0F7B6C"
                               FontSize="9" FontWeight="Bold" Margin="0 0 0 6"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Reset View"
                                Click="OnResetView"
                                Padding="16 4" Margin="0 0 6 0"
                                Background="#2A2A4A" Foreground="White" BorderThickness="0"/>
                        <Button Content="Snapshot"
                                Click="OnSnapshot"
                                Padding="16 4" Margin="0 0 6 0"
                                Background="#1A4A7A" Foreground="White" BorderThickness="0"/>
                        <Button Content="{Binding RecordText}"
                                Command="{Binding ToggleRecordCommand}"
                                Padding="16 4" Margin="0 0 6 0"
                                Background="#0F7B6C" Foreground="White" BorderThickness="0"/>
                        <Button Content="{Binding PauseText}"
                                Command="{Binding TogglePauseCommand}"
                                Padding="16 4"
                                Background="#2A4A6A" Foreground="White" BorderThickness="0"/>
                    </StackPanel>

                    <!-- Snapshot saved notification — hidden until first snapshot -->
                    <TextBlock x:Name="SnapshotNotification"
                               Visibility="Collapsed" Margin="0 5 0 0" FontSize="11">
                        <Run Text="Saved: " Foreground="#8892A4"/>
                        <Hyperlink x:Name="SnapshotLink" Click="OnSnapshotLinkClick"
                                   Foreground="#4A9EFF" TextDecorations="Underline">
                            <Run x:Name="SnapshotLinkText"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="#16213E" CornerRadius="4" Padding="10 4" Margin="0 8 0 0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="250 Hz  |  8-byte packets  |  CRC-16 CCITT"
                           Foreground="#8892A4" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DroppedText}"
                           Foreground="#E94560" FontSize="11" Margin="24 0 0 0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main area: waveform + BPM panel -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160" MinWidth="140" MaxWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- ScottPlot waveform with overlays -->
            <Grid Grid.Column="0">
                <sp:WpfPlot x:Name="WpfPlot" MouseMove="OnPlotMouseMove" MouseLeave="OnPlotMouseLeave"/>

                <!-- Waveform selector: top-right corner -->
                <Border Background="#AA16213E" CornerRadius="4" Padding="8 4"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                    <StackPanel Orientation="Vertical">
                        <CheckBox Content="Raw"
                                  IsChecked="{Binding IsDisplayRaw, Mode=TwoWay}"
                                  Foreground="#00FF88" FontSize="11" Margin="0 0 0 2"/>
                        <CheckBox Content="Filtered"
                                  IsChecked="{Binding IsDisplayFiltered, Mode=TwoWay}"
                                  Foreground="#FF4444" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Hover tooltip: bottom-left corner, hidden until mouse moves over plot -->
                <Border x:Name="HoverTooltip"
                        Background="#CC16213E" CornerRadius="4" Padding="8 5"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="HoverText"
                               Foreground="#E0E0E0" FontSize="11" FontFamily="Consolas"/>
                </Border>
            </Grid>

            <!-- BPM panel -->
            <Border Grid.Column="1" Background="#16213E" CornerRadius="4" Margin="8 0 0 0">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="140">

                    <TextBlock Text="HEART RATE" Foreground="#8892A4"
                               FontSize="11" HorizontalAlignment="Center" Margin="0 0 0 8"/>

                    <!-- Large BPM number — green normally, red on alarm (SR-07) -->
                    <TextBlock Text="{Binding BpmText}"
                               FontSize="48" FontWeight="Bold"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#555"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Foreground" Value="#00FF88"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBpmAlarm}" Value="True">
                                        <Setter Property="Foreground" Value="#E94560"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="BPM" Foreground="#8892A4"
                               FontSize="13" HorizontalAlignment="Center" Margin="0 2 0 24"/>

                    <!-- Alarm indicator -->
                    <TextBlock Text="&#x26A0; OUT OF RANGE" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#E94560" Margin="0 0 0 16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBpmAlarm}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- BPM range configuration (SR-07) -->
                    <TextBlock Text="NORMAL RANGE" Foreground="#8892A4"
                               FontSize="10" HorizontalAlignment="Center" Margin="0 0 0 6"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 4">
                        <TextBlock Text="Min" Foreground="#8892A4" FontSize="11" VerticalAlignment="Center" Margin="0 0 4 0"/>
                        <TextBox Text="{Binding BpmMin, UpdateSourceTrigger=PropertyChanged}"
                                 Width="40" Padding="3 2" FontSize="12"
                                 Background="#0F3460" Foreground="White" BorderBrush="#533483"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Max" Foreground="#8892A4" FontSize="11" VerticalAlignment="Center" Margin="0 0 4 0"/>
                        <TextBox Text="{Binding BpmMax, UpdateSourceTrigger=PropertyChanged}"
                                 Width="40" Padding="3 2" FontSize="12"
                                 Background="#0F3460" Foreground="White" BorderBrush="#533483"/>
                    </StackPanel>

                </StackPanel>
                </Viewbox>
            </Border>
        </Grid>

    </DockPanel>
</Window>